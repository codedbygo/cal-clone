# =============================================================================
# LOCAL DEVELOPMENT — copy to backend/.env
# Use a dedicated Neon project or branch (e.g. "cal-clone-dev")
# =============================================================================

# Pooled connection (hostname contains "-pooler") — app runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-dev-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection (no "-pooler") — prisma migrate & booking transactions
DIRECT_URL="postgresql://USER:PASSWORD@ep-dev-xxx.region.aws.neon.tech/neondb?sslmode=require"

PORT=4000
FRONTEND_URL=http://localhost:3000

# OAuth — Apps integrations (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_REDIRECT_URI=http://localhost:4000/api/integrations/zoom/callback
# OAUTH_STATE_SECRET=change-me-in-production

# =============================================================================
# PRODUCTION / DEMO (Vercel backend env vars) — separate Neon project!
# Create a second Neon project e.g. "cal-clone-prod" — never reuse dev URLs.
# =============================================================================
#
# DATABASE_URL=postgresql://...@ep-prod-xxx-pooler.../neondb?sslmode=require
# DIRECT_URL=postgresql://...@ep-prod-xxx.../neondb?sslmode=require
# FRONTEND_URL=https://your-frontend.vercel.app
# PORT=4000
